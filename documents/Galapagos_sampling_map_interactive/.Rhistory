c(xmin = -91.7, ymin = -1.45, xmax = -89.25, ymax = 0.45),
# and use the standard WGS84
crs = sf::st_crs(4326)) #
class(map_bbox) # makes a special R object
str(map_bbox) # but it's basically a special vector with some additional information appended as a list
## We can then read in a high-res shapefile of the world's shorelines from NOAA
## which we can then crop to contain just teh Galapagos with st_crop()
# Temporarily use planar geometry for cleaning/cropping this shoreline file
old_s2 <- sf::sf_use_s2()
sf::sf_use_s2(FALSE)
islands_map <- world_shp %>%
sf::st_transform(4326) %>%
sf::st_make_valid() %>%
sf::st_crop(map_bbox)
# Restore sf's previous geometry setting
sf::sf_use_s2(old_s2)
## Prepare clickable points:
individuals_map <- individuals %>%
mutate(sample_number = row_number(),
popup_text = paste0(
"<strong>Individual ", sample_number, "</strong><br>",
"Longitude: ", round(long, 4), "<br>",
"Latitude: ", round(lat, 4)))
## Let's make the points colored by species:
species_colors <- c(
"xylocopa darwini" = "#CDD4DD",
"Phoebis sennae marcellina" = "#FFF1C1",
"Leptotes parrhasioides" = "#D6E5F5",
"Hemiargus ramon" = "#B0CDEA",
"Anax amazili" = "#DBEDD2",
"Schistocera melanocera" = "#FC70FF",
"Erinnyis ello encantada" = "#F0A072")
species_pal <- leaflet::colorFactor(
palette = species_colors,
domain = names(species_colors),
na.color = "#999999")
interactive_sampling_map <- leaflet::leaflet(shared_specimens,
options = leaflet::leafletOptions(minZoom = 7, maxZoom = 20)) %>%
leaflet::addLabelOnlyMarkers(
data = island_labels, lng = ~long, lat = ~lat, label = ~island,
labelOptions = leaflet::labelOptions(
noHide = T,
direction = "center",
textOnly = TRUE,
style = list("font-weight" = "bold",
"font-size" = "12px",
"color" = "#1a1a1a",
"text-shadow" = "0 0 3px white, 0 0 3px white")),
group = "Island names") %>%
addProviderTiles(
leaflet::providers$OpenTopoMap,
group = "Topographic basemap") %>%
leaflet::addCircleMarkers(
data = shared_specimens,
lng = ~long,
lat = ~lat,
radius = 6,
color = "black",
weight = 1,
fillColor = ~species_pal(species_name),
fillOpacity = 0.85,
# Appears when the marker is clicked
popup = ~popup_text,
# Appears when the cursor hovers over the marker
label = ~specimen_id,
labelOptions = leaflet::labelOptions(
direction = "top",
opacity = 0.9,
textOnly = TRUE),
group = "Sampled specimens") %>%
addScaleBar(position = "topright") %>%
addLayersControl(
overlayGroups = c(
#"Sampled specimens",
"Island names"),
options = layersControlOptions(collapsed = T)) %>%
fitBounds(lng1 = -91.7, lat1 = -1.45,
lng2 = -89.25, lat2 = 0.45)
interactive_sampling_map
