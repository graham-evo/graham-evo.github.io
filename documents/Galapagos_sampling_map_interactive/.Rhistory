#### HERE MODIFIED THE CSS STYLING FOR THE MAP ###:
map_filter_css <- tags$style(HTML("
/* Overall page surrounding the map */
body {
background: #ffffff;
font-family: 'Helvetica', serif;
}
/* Left Crosstalk filter panel */
.map-filter-sidebar {
background: #f7f3ed;
border: 1px solid #d8cbc0;
border-top: 5px solid #b70a0a;
border-radius: 4px;
padding: 18px;
margin: 10px 0;
}
.map-filter-sidebar h3 {
color: #b70a0a;
font-size: 1.25rem;
margin-top: 0;
margin-bottom: 0.4rem;
}
.map-filter-sidebar p {
color: #555555;
font-size: 0.9rem;
line-height: 1.4;
margin-bottom: 18px;
}
/* Crosstalk dropdown labels */
.map-filter-sidebar .control-label {
color: #000000;
font-size: 0.9rem;
font-weight: bold;
margin-bottom: 5px;
}
.map-filter-sidebar .form-group {
margin-bottom: 16px;
}
/* Closed dropdown */
.map-filter-sidebar .selectize-input {
border: 1px solid #b9aaa0;
border-radius: 3px;
box-shadow: none;
background: #ffffff;
}
.map-filter-sidebar .selectize-input.focus {
border-color: #b70a0a;
box-shadow: 0 0 0 2px rgba(183, 10, 10, 0.15);
}
/* Dropdown options */
.map-filter-sidebar .selectize-dropdown {
border-color: #b9aaa0;
border-radius: 3px;
}
.map-filter-sidebar .selectize-dropdown .active {
background: #f2d7d7;
color: #4b0000;
}
/* Leaflet popup styling */
.leaflet-popup-content-wrapper {
border-radius: 4px;
}
.leaflet-popup-content h3 {
color: #b70a0a;
}
.leaflet-tooltip {
background: #ffffff;
border: 1px solid #b70a0a;
color: #333333;
font-weight: bold;
box-shadow: none;
}
/* Stack filters above the map on narrow screens */
@media (max-width: 767px) {
.map-filter-sidebar {
margin-bottom: 18px;
}
}
"))
filter_sidebar <- tags$div(
class = "map-filter-sidebar",
tags$h3("Filter specimens"),
tags$p(
"Choose one or more values below. Filters are combined, so only specimens matching all active filters are shown."
),
species_filter,
sequenced_filter,
dnaType_filter
)
interactive_filter_map <- tagList(
map_filter_css,
crosstalk::bscols(
widths = c(3, 9),
filter_sidebar,
interactive_sampling_map
)
)
htmltools::browsable(interactive_filter_map)
